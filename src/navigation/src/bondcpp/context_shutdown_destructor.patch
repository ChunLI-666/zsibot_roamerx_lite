+  // Final notification may create a timer. Once this Node's Context is closed,
+  // only release resources; ROS entities can no longer be created or notified.
+  const auto context = node_base_->get_context();
+  if (context->is_valid()) {
+    try {
+      breakBond();
+      if (context->is_valid() && rclcpp::ok() &&
+        !waitUntilBroken(rclcpp::Duration(100ms)))
+      {
+        RCLCPP_DEBUG(
+          node_logging_->get_logger(), "Bond failed to break on destruction %s (%s)",
+          id_.c_str(), instance_id_.c_str());
+      }
+    } catch (const rclcpp::exceptions::RCLError &) {
+      // Context can close after the check above. Do not hide errors from a
+      // still-live Context: preserve this destructor's original noexcept exit.
+      if (context->is_valid()) {std::terminate();}
+    }
   }
 
   publishingTimerCancel();
